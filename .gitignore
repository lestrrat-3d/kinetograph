# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Go workspace file
go.work
go.work.sum

# env file
.env

# Frames and videos the clip programs write
_clips/*/out/

# Frames and the ffmpeg script the gallery program writes
_gallery/out/
_gallery/assemble.sh

# Scratch output and agent worktrees
.tmp/
.worktrees/
.review-gauntlet/
.gauntlet/
